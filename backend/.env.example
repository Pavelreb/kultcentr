# Пример конфигурации для продакшена.
# Скопируйте в .env и подставьте свои значения: cp .env.example .env
# ВНИМАНИЕ: файл .env НЕ коммитится (уже в .gitignore).

# Сгенерируйте новый ключ: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=сгенерируйте-новый-секретный-ключ

DEBUG=False

# Домен и IP сервера через запятую
ALLOWED_HOSTS=ваш-домен.ru,www.ваш-домен.ru,IP-сервера

# Откуда разрешены запросы к API (адрес сайта)
CORS_ALLOWED_ORIGINS=https://ваш-домен.ru

# Для входа в админку через домен
CSRF_TRUSTED_ORIGINS=https://ваш-домен.ru
